# Web Desktop Wrapper Configuration
# Copy this file to .env and adjust values for your application
# See README.md for more information about each setting

# ============================================================================
# Application Identity
# ============================================================================

# Display name for the application window and file dialogs
APP_NAME=DIGI Express Admin

# Organization name for file storage paths (AppData\Local\{ORG}\{PROFILE})
APP_ORGANIZATION=DIGI Express

# ============================================================================
# Web Application URL & Security
# ============================================================================

# The URL of the web application to display
# Examples:
WEB_APP_URL=https://127.0.0.1:8000

# Allowed hosts that the application can navigate to
# Comma-separated list; the WEB_APP_URL hostname is automatically included
# Examples:
#   - api.example.com,cdn.example.com
#   - (empty to allow only the WEB_APP_URL host)
WEB_APP_ALLOWED_HOSTS=

# Allow navigation to subdomains of allowed hosts
# Set to true if you need to access sub.example.com when example.com is allowed
ALLOW_SUBDOMAINS=false

# Allow HTTP (insecure) connections for local development
# WARNING: Never set to true for production URLs
ALLOW_INSECURE_HTTP=false

# Open external links in the default browser instead of in the WebView
# Set to true if you want links to external sites to open in Edge/Chrome
OPEN_EXTERNAL_LINKS=true

# ============================================================================
# Window Appearance & Behavior
# ============================================================================

# Width of the application window on startup (pixels)
WINDOW_WIDTH=1280

# Height of the application window on startup (pixels)
WINDOW_HEIGHT=800

# Start the application in maximized mode
START_MAXIMIZED=true

# Prevent duplicate application windows; brings existing window to front
SINGLE_INSTANCE=true

# Show a full-window animated splash screen on startup (Once Human style)
SHOW_SPLASH=true

# Legacy splash duration setting. The app now dismisses the splash as soon as
# the web application is ready; this value is retained for config compatibility.
SPLASH_DURATION=4.5

# macOS release mode: development (ad-hoc) or direct (Developer ID + notarization)
MACOS_DISTRIBUTION=development

# Exact Developer ID identity shown by: security find-identity -v -p codesigning
MACOS_SIGNING_IDENTITY=

# Keychain profile created by: xcrun notarytool store-credentials PROFILE_NAME
MACOS_NOTARY_PROFILE=

# Background color to show before the web page loads (as #RRGGBB hex)
# Match your web application's background for a seamless appearance
PAGE_BACKGROUND_COLOR=#ffffff

# Path to application icon file (supports .ico, .png, .jpg)
# Leave empty to use default Windows icon
# Examples:
#   - ./assets/icon.ico
#   - C:\path\to\icon.png
APP_ICON=

# ============================================================================
# System Tray Integration
# ============================================================================

# Enable system tray icon with Open, Reload, and Exit context menu
ENABLE_SYSTEM_TRAY=true

# Minimize application to system tray when closed or minimized
MINIMIZE_TO_TRAY=false

# ============================================================================
# Session, Storage & Downloads
# ============================================================================

# Persist the WebView2 session (cookies, site storage) between runs
# Set to false to start with a clean session each time
PERSIST_SESSION=true

# Profile name for session storage within the organization folder
# Allows multiple application instances to maintain separate sessions
# Examples:
#   - production
#   - staging
#   - user-profile-name
PROFILE_NAME=default

# Allow users to download files
ALLOW_DOWNLOADS=false

# Optional custom directory to save downloaded files automatically (leave empty for default)
DEFAULT_DOWNLOADS_PATH=

# Show native completion notifications when file downloads finish
SHOW_DOWNLOAD_NOTIFICATIONS=true

# ============================================================================
# Advanced Browser & System Options
# ============================================================================

# Custom User-Agent header (leave empty to use standard WebView2 / WebKit default)
USER_AGENT=

# Browser locale and Accept-Language (e.g. en-US, th-TH, vi-VN, ja-JP)
BROWSER_LOCALE=

# Automatically launch the application on system startup / login
RUN_ON_STARTUP=false

# Allow dropping local files onto the window to navigate (defaults to false for security)
ALLOW_FILE_DROP=false

# ============================================================================
# Application Version & Request Headers
# ============================================================================

# Desktop wrapper version sent in the 'X-Wrapper-Version' HTTP request header on every request
APP_WRAPPER_VERSION=1.0.1

# ============================================================================
# Build & Compilation Engine
# ============================================================================

# Compiler engine: 'pyinstaller' (default) or 'nuitka' (native C++ compilation)
# Nuitka translates Python to C++ and compiles to machine code for maximum reverse engineering defense.
BUILDER_ENGINE=pyinstaller

# Embed offline MicrosoftEdgeWebView2RuntimeInstaller installers inside Setup.exe (true)
# or skip embedding offline runtimes to produce a lightweight installer (false)
EMBED_WEBVIEW2_RUNTIME=true

# ============================================================================
# Development & Debugging Notes
# ============================================================================

# For local development:
# - Use http://127.0.0.1 or http://localhost for web server
# - Set ALLOW_INSECURE_HTTP=true only if not using HTTPS locally
#
# For production:
# - Always use HTTPS URLs
# - Never set ALLOW_INSECURE_HTTP=true
# - Restrict ALLOW_DOWNLOADS to false if not needed
# - Keep PERSIST_SESSION=true for user convenience
# - Use BUILDER_ENGINE=nuitka to harden against decompilers
#
# Boolean values accept: true, false, 1, 0, yes, no, on, off
# 
# Environment variables override embedded configuration (from build)
# Unset variables fall back to embedded config or defaults

